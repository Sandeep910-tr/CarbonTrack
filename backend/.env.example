# ============================================================
# CarbonTrack Logistics System - Environment Variables (TEMPLATE)
#
# Copy this file to `.env` in the same directory and fill in real values.
# `.env` is already in .gitignore - NEVER commit a filled-in .env, and never
# paste real keys/passwords into a README, commit message, issue, or chat.
#
# If you're reading this because a previous `.env` with real keys already
# made it into git history or a chat log: rotate every key below immediately
# (Google Cloud Console for Maps/Routes/Places, openweathermap.org/api_keys
# for OpenWeather, Google Account -> Security -> App Passwords for Gmail,
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
# for AADHAAR_ENCRYPTION_KEY), then scrub the old .env out of git history
# (e.g. `git filter-repo` or BFG) - deleting the file in a new commit does
# NOT remove it from history.
# ============================================================

SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_SECRET_KEY=change-this-to-a-different-long-random-string

# Encrypts Aadhaar numbers at rest (see backend/security.py). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CRITICAL: if you rotate this key and already have Aadhaar data encrypted
# under the old one, that data must be decrypted with the OLD key and
# re-encrypted under the NEW key in the same migration step - swapping the
# key alone makes existing encrypted values permanently unreadable.
AADHAAR_ENCRYPTION_KEY=REPLACE_WITH_YOUR_OWN_FERNET_KEY

# Google Cloud Platform APIs - restrict each key by API + HTTP referrer/IP
# in Cloud Console before using it anywhere but local dev. Use separate keys
# per API where Cloud Console allows it, rather than one key for both Routes
# and Places, so a restriction change to one doesn't affect the other.
GOOGLE_MAPS_API_KEY=REPLACE_WITH_YOUR_OWN_GOOGLE_MAPS_KEY
GOOGLE_ROUTES_API_KEY=REPLACE_WITH_YOUR_OWN_GOOGLE_ROUTES_KEY
GOOGLE_PLACES_API_KEY=REPLACE_WITH_YOUR_OWN_GOOGLE_PLACES_KEY

# OpenWeather API - https://openweathermap.org/api_keys
OPENWEATHER_API_KEY=REPLACE_WITH_YOUR_OWN_OPENWEATHER_KEY

# Comma-separated list of frontend origins allowed to call this API in
# production (e.g. "https://app.example.com"). Leave empty in local dev -
# app.py falls back to the Vite dev-server origins automatically. Setting
# this is REQUIRED before a production deploy; the API fails CLOSED (blocks
# all browser origins) rather than open if you forget.
CORS_ORIGINS=

# Rate-limit storage backend. "memory://" (default) is fine for a single
# process; point at Redis (e.g. redis://localhost:6379) if you run more than
# one worker/instance, since in-memory limits aren't shared across processes.
RATELIMIT_STORAGE_URI=memory://

# ============================
# Email OTP Configuration
# ============================
# Fill in real SMTP credentials to send real emails - otherwise OTPs are
# printed to the backend console/log when DEV_MODE=true.

DEV_MODE=true

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_YOUR_OWN_GMAIL_ADDRESS
# Use a Gmail App Password, not your account password:
# Google Account -> Security -> 2-Step Verification -> App Passwords
SMTP_PASSWORD=REPLACE_WITH_YOUR_OWN_APP_PASSWORD
SMTP_FROM=CarbonTrack Logistics <REPLACE_WITH_YOUR_OWN_GMAIL_ADDRESS>

# ============================
# Firebase (frontend, VITE_-prefixed vars are inlined into the client bundle
# at build time - never put a server-only secret behind a VITE_ prefix).
# Firebase web API keys are meant to be public/client-visible by design -
# they're restricted by Firebase Security Rules + authorized domains in the
# console, not by keeping this value secret. This .env is the single source
# of truth - there's no need to also keep the raw <script> snippet the
# Firebase console gives you anywhere in the codebase.
# ============================
VITE_FIREBASE_API_KEY=REPLACE_WITH_YOUR_OWN_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_YOUR_OWN_FIREBASE_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=REPLACE_WITH_YOUR_OWN_FIREBASE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=REPLACE_WITH_YOUR_OWN_FIREBASE_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_YOUR_OWN_FIREBASE_SENDER_ID
VITE_FIREBASE_APP_ID=REPLACE_WITH_YOUR_OWN_FIREBASE_APP_ID
